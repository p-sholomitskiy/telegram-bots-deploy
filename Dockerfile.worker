
# Этап 1. Сборка обоих ботов
FROM node:22-slim AS builder

WORKDIR /app

COPY . .

RUN npm ci
RUN npm run install:bots
RUN npm run build:bots


# Этап 2. Production-образ
FROM node:22-slim

WORKDIR /app

ENV NODE_ENV=production

# Копируем собранные проекты
COPY --from=builder /app /app

# Удаляем зависимости разработки
RUN npm prune --omit=dev \
    && npm prune --omit=dev --prefix bots/comedy-hall \
    && npm prune --omit=dev --prefix bots/globusbus

RUN chown -R node:node /app

USER node

CMD ["npm", "start"]
